# 複製成 .env 後填入（.env 不進 git）。本機測試：npm run dev，開 http://localhost:8778
# 正式站在 Zeabur 介面設定 GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET、ADMIN_EMAILS（其他由 Dockerfile 設好）
PORT=8778
PUBLIC_URL=http://localhost:8778
SERVE_STATIC=1
GOOGLE_CLIENT_ID=414010783574-jp647ur0ea3ce898n5e5f2col38104to.apps.googleusercontent.com
# 用戶端密碼：Google Cloud → Google Auth Platform → 用戶端，只填在 .env 或 Zeabur，不要貼到網頁、git 或對話裡
GOOGLE_CLIENT_SECRET=
# 管理員信箱（逗號分隔）：啟動時自動加進允許名單並設成管理員。其他可以登入的信箱／網域由管理員在 /admin.html 加入
ADMIN_EMAILS=
