# 與 railpack 靜態站自動產生的設定相同，只把網站根目錄改成 /srv（設定檔不再被當成網站檔案公開）。
# /api/（Google 登入、雲端存檔）轉給同一個容器裡的 Node 伺服器（server/server.js，見 start.sh）。
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# 頁面與遊戲程式每次都向伺服器確認是否有新版（有 ETag，沒變只回 304），部署後玩家立刻拿到新版；
	# 否則 Cloudflare 會把 .js／.css 快取 4 小時
	@fresh path / /index.html /gate.js /game.js /style.css /privacy.html /admin.html /admin /admin.js
	header @fresh Cache-Control "no-cache"

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	encode {
		gzip
		zstd
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$API_PORT:8081}
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/index.html
		file_server {
			hide .git
			hide .env*
		}
	}

	handle_errors {
		root * /srv
		rewrite * /{err.status_code}.html
		file_server
	}
}
